# Helius (recommended) — https://dashboard.helius.dev
HELIUS_API_KEY=

# RugCheck optional key for higher rate limits — https://api.rugcheck.xyz
# Public endpoints work without a key
RUGCHECK_API_KEY=

# Solscan Pro optional — for programmatic holders
SOLSCAN_API_KEY=

# Optional LLM keys (future)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

PAPER_STARTING_BALANCE=10000
ENABLE_REAL_TRADING=false
