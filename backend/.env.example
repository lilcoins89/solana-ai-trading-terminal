# Helius (recommended) — free key at https://dashboard.helius.dev
# Enables top-holder concentration, mint/freeze authority checks
HELIUS_API_KEY=

# Optional: for enhanced LLM reasoning (otherwise pure rule-based + heuristics)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Default LLM provider if keys are present: openai | anthropic | xai | groq
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Paper trading starting balance (USD)
PAPER_STARTING_BALANCE=10000

# Safety: real trading is OFF by default
ENABLE_REAL_TRADING=false
